digraph UploadFlow {
 graph [label="Akış 1 | Ses Yükleme ve Kalite Kontrolü",labelloc=t,fontsize=20,fontname="DejaVu Sans",rankdir=TB,splines=polyline,nodesep=.3,ranksep=.4,pad=.2];
 node[fontname="DejaVu Sans",shape=box,style="rounded,filled",fillcolor="#EFF6FF",color="#93B7DD",fontsize=11];edge[fontname="DejaVu Sans",fontsize=9,color="#52647B"];
 a[label="Başlangıç / kullanıcı oturumu",shape=oval,fillcolor="#DCFCE7"];b[label="Oturum geçerli mi?",shape=diamond,fillcolor="#FEF3C7"];c[label="WAV seç ve yükle"];d[label="Dosya türü, boyutu, süresi uygun mu?",shape=diamond,fillcolor="#FEF3C7"];e[label="Ses boş / aşırı sessiz / bozuk mu?",shape=diamond,fillcolor="#FEF3C7"];s[label="Referans örnek kimliği\nsunucu tarafında doğrulandı mı?",shape=diamond,fillcolor="#FEF3C7"];p[label="Yalnız kalite bilgisi oluştur",fillcolor="#F1F5F9"];i[label="E0 / E1 / E2 modeliyle tahmin al"];save[label="Sonucu / kalite raporunu\nyalnız kullanıcı hesabına kaydet"];end[label="Sonuç ekranı (araştırma uyarısıyla)",shape=oval,fillcolor="#DCFCE7"];err1[label="401 - Giriş gerekli",fillcolor="#FFE4E6",color="#D28B9A"];err2[label="400/413 - Biçim / boyut / süre hatası",fillcolor="#FFE4E6",color="#D28B9A"];err3[label="422 - Kalite hatası ve gerekçe",fillcolor="#FFE4E6",color="#D28B9A"];
 a->b;b->c[label="Evet"];b->err1[label="Hayır"];c->d;d->e[label="Evet"];d->err2[label="Hayır"];e->err3[label="Evet"];e->s[label="Hayır"];s->i[label="Evet"];s->p[label="Hayır / harici"];p->save;i->save;save->end;
}