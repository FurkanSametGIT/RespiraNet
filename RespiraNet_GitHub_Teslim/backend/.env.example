# Create backend/.env manually and set a different random secret (do not commit it).
# For standalone SQLite demo (no external PostgreSQL):
DATABASE_URL=sqlite:///./respiranet-dev.db
AUTO_CREATE_TABLES=true
# Example only; replace with at least 32 random characters!
JWT_SECRET=CHANGE_ME_GENERATE_RANDOM_SECRET_AT_LEAST_32_CHARS
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./private_uploads
REPORT_FILE=../experiments/comparison.json
