{
 "info":{"name":"RespiraNet - Hafta 4 FastAPI","description":"Ders prototipi. Önce register ve login; login yanıtındaki access_token'ı token değişkenine elle girin.","schema":"https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
 "variable":[{"key":"base_url","value":"http://localhost:8000"},{"key":"token","value":""},{"key":"recording_id","value":""}],
 "item":[
  {"name":"Health","request":{"method":"GET","url":"{{base_url}}/api/health"}},
  {"name":"Register","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"full_name\":\"Demo Kullanıcı\",\"email\":\"demo@example.com\",\"password\":\"ChangeThisDemo123!\"}"},"url":"{{base_url}}/api/auth/register"}},
  {"name":"Login","request":{"method":"POST","header":[{"key":"Content-Type","value":"application/x-www-form-urlencoded"}],"body":{"mode":"urlencoded","urlencoded":[{"key":"username","value":"demo@example.com"},{"key":"password","value":"ChangeThisDemo123!"}]},"url":"{{base_url}}/api/auth/login"},"event":[{"listen":"test","script":{"exec":["if (pm.response.code === 200) pm.collectionVariables.set('token', pm.response.json().access_token);"],"type":"text/javascript"}}]},
  {"name":"Me","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/api/auth/me"}},
  {"name":"Upload WAV (choose file)","request":{"method":"POST","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"body":{"mode":"formdata","formdata":[{"key":"file","type":"file","src":""}]},"url":"{{base_url}}/api/recordings"}},
  {"name":"List recordings","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/api/recordings"}},
  {"name":"Get recording","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/api/recordings/{{recording_id}}"}},
  {"name":"Update note","request":{"method":"PATCH","header":[{"key":"Authorization","value":"Bearer {{token}}"},{"key":"Content-Type","value":"application/json"}],"body":{"mode":"raw","raw":"{\"notes\":\"Hafta 5 CRUD denemesi\"}"},"url":"{{base_url}}/api/recordings/{{recording_id}}"}},
  {"name":"Delete recording","request":{"method":"DELETE","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/api/recordings/{{recording_id}}"}},
  {"name":"Experiment report","request":{"method":"GET","header":[{"key":"Authorization","value":"Bearer {{token}}"}],"url":"{{base_url}}/api/experiments"}}
 ]
}
